// This file is generated by CMake from cmake/app.rc.in.
// Do not edit the generated app.rc; change packaging/product.json instead.
//
// Windows resource script for the application executable: the taskbar/Explorer
// icon plus a VERSIONINFO block so the .exe carries product name, version, and
// copyright metadata. All values come from packaging/product.json.

#include <windows.h>

IDI_ICON1 ICON "@PRODUCT_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PRODUCT_VERSION_MAJOR@,@PRODUCT_VERSION_MINOR@,@PRODUCT_VERSION_PATCH@,@PRODUCT_VERSION_BUILD@
 PRODUCTVERSION @PRODUCT_VERSION_MAJOR@,@PRODUCT_VERSION_MINOR@,@PRODUCT_VERSION_PATCH@,@PRODUCT_VERSION_BUILD@
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@PRODUCT_PUBLISHER@"
            VALUE "FileDescription",  "@PRODUCT_DISPLAY_NAME@"
            VALUE "FileVersion",      "@PRODUCT_VERSION@"
            VALUE "InternalName",     "@PRODUCT_EXE_NAME@"
            VALUE "LegalCopyright",   "@PRODUCT_COPYRIGHT@"
            VALUE "OriginalFilename", "@PRODUCT_EXE_NAME@.exe"
            VALUE "ProductName",      "@PRODUCT_DISPLAY_NAME@"
            VALUE "ProductVersion",   "@PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
