/*!
    \page project-structure.html
    \title Projektstruktur
    \previouspage Architektur
    \nextpage Fehlerbehebung

    Dieses Kapitel ist eine Karte von \e{"Wo ist X umgesetzt?"} zum Quellbaum. Es ist bewusst
    keine vollständige Dateiliste; es verweist auf das Verzeichnis und die wenigen wichtigen
    Dateien jedes Bereichs, jeweils mit Verweis in die \l {OpcUaManager API Reference}.

    \section1 Oberste Ebene

    \table
    \header \li Verzeichnis \li Rolle
    \row \li \c app/ \li GUI-Anwendung: Start, QML-Engine-Wrapper, Anwendungsdienste.
    \row \li \c src/ \li Wiederverwendbare C++-Bibliotheken (Client-Kern, Modelle, Persistenz, Projekte, Fassaden).
    \row \li \c runtime/ \li Eigenständige open62541-OPC-UA-Server-Anwendung.
    \row \li \c qml/ \li Anwendungs-QML-Modul (Bildschirme/Dialoge) und das wiederverwendbare Modul \c qml/Base.
    \row \li \c resources/ \li Mitgelieferte Bilder/SVG und QML-Stilkonfiguration.
    \row \li \c doc/ \li Diese Dokumentation (QDoc-Handbuchseiten, API-Themen, Konfiguration).
    \row \li \c packaging/, \c installer/ \li Release-Pipeline, Installer und Produktmetadaten.
    \endtable

    \section1 Wo jede Funktion liegt

    \table
    \header \li Um zu arbeiten an… \li Schauen Sie in… \li Wichtige Typen
    \row \li Client-Verbindung / Discovery / Abonnements
         \li \c src/core/opcuaservice.* \li \l OpcUaService
    \row \li Das Client-Objekt, mit dem QML spricht
         \li \c src/qmlapi/opcuamanager.* \li \l OpcUaManager
    \row \li Adressraum-Baum (Durchsuchen)
         \li \c src/models/opcuamodel.*, \c treeitem.* \li \l OpcUaModel, \l TreeItem
    \row \li Knotenattribute / Werte / Trends
         \li \c src/models/ \li \l AttributesModel, \l DataAccessModel, \l TrendModel
    \row \li Dekodieren strukturierter (CODESYS-)Werte
         \li \c src/core/structurednodereader.* \li \c StructuredNodeReader
    \row \li Server-Entwurf + Laufzeitsteuerung
         \li \c src/qmlapi/serverstudio.*, \c serverruntimecontroller.* \li \l ServerStudio, \l ServerRuntimeController
    \row \li Server-Projektmodell / -Datei / -Validierung / NodeSet2
         \li \c src/serverproject/ \li \l{ServerProject}{ServerProject::*}
    \row \li Der eigenständige Server selbst
         \li \c runtime/ \li \c ProjectBuilder, \c SimulationEngine, \c SecuritySetup, \c DiagnosticsServer
    \row \li Client-Projekt (\c .uaproj)
         \li \c src/project/ \li \l ProjectData, \c ProjectSerializer
    \row \li Persistenz überwachter Knoten
         \li \c src/persistence/nodedatabase.* \li \l NodeDatabase
    \row \li Installierte/portable Pfade
         \li \c src/core/apppaths.* \li \l AppPaths
    \row \li Anwendungsstart / -dienste
         \li \c app/ \li \l AppCore, \l AppEngine, \l AppInfo, \l LocaleController
    \row \li UI-Rahmen und Bildschirme
         \li \c qml/Main.qml, \c qml/*Screen*.qml \li \l {OpcUaManager QML Types}
    \row \li Wiederverwendbare UI-Steuerelemente
         \li \c qml/Base/ \li \l {Base QML Types}
    \endtable

    \section1 Bibliotheken und ihre Grenzen

    \list
        \li \b OpcUaCore (\c src/core, \c src/models, \c src/persistence, \c src/project)
            — der Client-Stack; bindet Qt Core/Network/OpcUa/Sql ein.
        \li \b ServerProjectCore (\c src/serverproject) — \e{nur Qt Core}, sodass er von der GUI
            und der eigenständigen Laufzeit gemeinsam genutzt wird.
        \li \b OpcUaQmlApi (\c src/qmlapi) — die QML-Fassaden; hängt von beiden Kernen ab.
    \endlist

    Zur Begründung dieser Grenzen, Threads und Prozesse siehe \l {Architektur}.
*/
