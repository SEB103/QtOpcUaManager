/*!
    \page project-structure.html
    \title Структура проєкту
    \previouspage Архітектура
    \nextpage Усунення несправностей

    Цей розділ — карта від питання \e{«Де реалізовано X?»} до дерева сирців. Це навмисно не
    вичерпний список файлів; він указує на каталог і кілька ключових файлів кожної області, кожен із
    посиланням у \l {OpcUaManager API Reference}.

    \section1 Верхній рівень

    \table
    \header \li Каталог \li Призначення
    \row \li \c app/ \li Виконуваний файл GUI: запуск, обгортка QML-рушія, сервіси застосунку.
    \row \li \c src/ \li Повторно використовувані C++-бібліотеки (ядро клієнта, моделі, персистентність, проєкти, фасади).
    \row \li \c runtime/ \li Автономний виконуваний файл OPC UA-сервера на open62541.
    \row \li \c qml/ \li QML-модуль застосунку (екрани/діалоги) та повторно використовуваний модуль \c qml/Base.
    \row \li \c resources/ \li Постачені зображення/SVG та конфігурація стилю QML.
    \row \li \c doc/ \li Ця документація (сторінки посібника QDoc, теми API, конфігурація).
    \row \li \c packaging/, \c installer/ \li Конвеєр релізу, інсталятор та метадані продукту.
    \endtable

    \section1 Де міститься кожна функція

    \table
    \header \li Щоб працювати над… \li Дивіться в… \li Ключові типи
    \row \li Підключення клієнта / виявлення / підписки
         \li \c src/core/opcuaservice.* \li \l OpcUaService
    \row \li Об'єкт клієнта, з яким говорить QML
         \li \c src/qmlapi/opcuamanager.* \li \l OpcUaManager
    \row \li Дерево адресного простору (перегляд)
         \li \c src/models/opcuamodel.*, \c treeitem.* \li \l OpcUaModel, \l TreeItem
    \row \li Атрибути вузлів / значення / тренди
         \li \c src/models/ \li \l AttributesModel, \l DataAccessModel, \l TrendModel
    \row \li Декодування структурованих (CODESYS) значень
         \li \c src/core/structurednodereader.* \li \c StructuredNodeReader
    \row \li Проєктування сервера + керування середовищем виконання
         \li \c src/qmlapi/serverstudio.*, \c serverruntimecontroller.* \li \l ServerStudio, \l ServerRuntimeController
    \row \li Модель / файл / валідація серверного проєкту / NodeSet2
         \li \c src/serverproject/ \li \l{ServerProject}{ServerProject::*}
    \row \li Сам автономний сервер
         \li \c runtime/ \li \c ProjectBuilder, \c SimulationEngine, \c SecuritySetup, \c DiagnosticsServer, \c RuleEngine
    \row \li Клієнтський проєкт (\c .uaproj)
         \li \c src/project/ \li \l ProjectData, \c ProjectSerializer
    \row \li Персистентність відстежуваних вузлів
         \li \c src/persistence/nodedatabase.* \li \l NodeDatabase
    \row \li Встановлені/портативні шляхи
         \li \c src/core/apppaths.* \li \l AppPaths
    \row \li Запуск застосунку / сервіси
         \li \c app/ \li \l AppCore, \l AppEngine, \l AppInfo, \l LocaleController
    \row \li Оболонка UI та екрани
         \li \c qml/Main.qml, \c qml/*Screen*.qml \li \l {OpcUaManager QML Types}
    \row \li Повторно використовувані елементи керування UI
         \li \c qml/Base/ \li \l {Base QML Types}
    \endtable

    \section1 Бібліотеки та їхні межі

    \list
        \li \b OpcUaCore (\c src/core, \c src/models, \c src/persistence, \c src/project)
            — клієнтський стек; пов'язує Qt Core/Network/OpcUa/Sql.
        \li \b ServerProjectCore (\c src/serverproject) — \e{лише Qt Core}, тому використовується
            спільно GUI та автономним середовищем виконання.
        \li \b OpcUaQmlApi (\c src/qmlapi) — QML-фасади; залежить від обох ядер.
    \endlist

    Обґрунтування цих меж, потоків і процесів див. у \l {Архітектура}.
*/
