# Shared QDoc base configuration for the OpcUaManager documentation.
#
# This file holds only the settings common to every generated documentation
# set. The project name, version, source/header directories, landing page,
# QHP block and cross-set index directories are written per set by
# cmake/OpcUaManagerDocs.cmake, which includes this file.

outputformats = HTML
sourceencoding = UTF-8
naturallanguage = en

# Link the generated API/manual against the installed Qt documentation so that
# Qt types referenced from the code resolve. The Qt index directory is passed on
# the qdoc command line by the CMake docs targets when it is available.
depends += \
    qtcore \
    qtgui \
    qtqml \
    qtquick \
    qtquickcontrols \
    qtopcua

# Do not fail the build on documentation warnings (0 disables the limit); the
# reference is generated from a large, evolving code base.
warninglimit = 0
reportmissingalttextforimages = true

# Point the Qt-branded breadcrumb ("Qt 6.11.1" / "Qt 6.11.1 Reference
# Documentation") at the official online Qt reference so it opens in the same
# embedded WebView. Always the English 6.11 documentation; never a localized URL.
# Our own landing stays the "OpcUaManager Guide" crumb (navigation.landingpage).
navigation.homepage = "https://doc.qt.io/qt-6.11/index.html"

# Override the Qt module template footer so the shipped pages do not assert Qt's
# copyright or the GNU Free Documentation License on this project's own
# documentation. This is included after qt-module-defaults, so it wins.
HTML.footer = \
    "  <div class=\"footer\">\n" \
    "    <p class=\"copy\">OpcUaManager documentation. Distributed with the application under its own license (GPL-3.0-or-later).</p>\n" \
    "  </div>\n"
